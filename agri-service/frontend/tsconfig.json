{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["./node_modules/vue"],
      "ant-design-vue": ["./node_modules/ant-design-vue"],
      "@agri/shared": ["../../packages/agri-shared/src/index.ts"],
      "@agri/shared/vue/workspace": ["../../packages/agri-shared/src/vue/workspace/index.ts"],
      "@agri/shared/vue/list": ["../../packages/agri-shared/src/vue/list/index.ts"],
      "@agri/shared/vue/antdv": ["../../packages/agri-shared/src/vue/antdv/index.ts"],
      "@agri/shared/vue/detail": ["../../packages/agri-shared/src/vue/detail/index.ts"],
      "@agri/shared/*": ["../../packages/agri-shared/src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
