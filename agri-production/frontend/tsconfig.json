{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@agri/shared": ["../../packages/agri-shared/src"],
      "@agri/shared/*": ["../../packages/agri-shared/src/*"],
      "vue": ["node_modules/vue"],
      "vue/*": ["node_modules/vue/*"],
      "pinia": ["node_modules/pinia"],
      "ant-design-vue": ["node_modules/ant-design-vue"],
      "ant-design-vue/*": ["node_modules/ant-design-vue/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*",
    "../../packages/agri-shared/src/vue/map/AgriVueTiandituBoundaryEditor.vue"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
