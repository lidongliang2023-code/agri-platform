{
  "name": "agri-production-frontend",
  "version": "1.0.0",
  "description": "农业生产管理模块前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx,vue --report-unused-disable-directives --max-warnings 0",
    "check:routes": "node scripts/check-routes.mjs",
    "check:pages": "node scripts/check-route-page-map.mjs",
    "check:menu": "node scripts/check-menu-route-map.mjs",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "lint:fix": "eslint src --fix --ext ts,tsx,vue",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,less}\""
  },
  "dependencies": {
    "@agri/shared": "workspace:*",
    "@ant-design/icons-vue": "7.0.1",
    "@tanstack/vue-query": "5.17.19",
    "ant-design-vue": "4.2.6",
    "axios": "1.16.0",
    "dayjs": "^1.11.10",
    "dompurify": "3.3.1",
    "echarts": "^5.5.0",
    "exceljs": "4.4.0",
    "lodash": "^4.17.21",
    "marked": "17.0.1",
    "pinia": "2.3.1",
    "quill": "2.0.3",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "3.1.0",
    "eslint": "^8.56.0",
    "less": "^4.6.4",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vue-tsc": "2.2.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
