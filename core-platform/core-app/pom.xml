<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agri</groupId>
        <artifactId>core-platform-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>core-app</artifactId>
    <name>core-app</name>
    <description>核心业务层唯一部署单元：模块化单体（交易域+生产域+服务域+平台域）+ Flyway 迁移 + ArchUnit CI 门禁</description>

    <dependencies>
        <dependency>
            <groupId>com.agri</groupId>
            <artifactId>mod-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agri</groupId>
            <artifactId>mod-trade</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agri</groupId>
            <artifactId>mod-produce</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agri</groupId>
            <artifactId>mod-service</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- 数据库变更一律走可回滚迁移（工程稳健性规范） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- CI 门禁：ArchUnit 依赖规则 + 表前缀归属，违规即构建失败（ADR-001 纪律 4） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
