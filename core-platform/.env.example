# ============ core-platform 环境变量样例（复制为 .env 或注入 K8s Secret） ============
# 数据库（MySQL 8）
MYSQL_URL=jdbc:mysql://localhost:3306/agri_core?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123
MYSQL_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 密钥（生产必须 ≥32 字符随机值；密钥绝不入库、绝不出现在代码中）
AGRI_JWT_SECRET=change-me-to-a-random-32bytes-secret!!

# 管理员初始口令（首启引导创建 admin 账号时使用，创建后请立即修改）
AGRI_ADMIN_PASSWORD=Admin@123

# 事件传输：local（开发/单机）| http（开发跨进程，卫星→核心）| rocketmq（生产，ADR-003）
AGRI_EVENT_TRANSPORT=local
ROCKETMQ_NAMESRV=localhost:9876
# http 传输专用：卫星服务指向核心单体
CORE_BASE_URL=http://localhost:8080
AGRI_INTERNAL_TOKEN=dev-internal-token

# CORS（显式来源，禁用通配符）
AGRI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI 网关（卫星）
AI_ENABLED=false
AI_GENERAL_BASE_URL=https://api.example-llm.com/v1
AI_GENERAL_API_KEY=
AI_GENERAL_MODEL=gpt-4o-mini

# IoT（卫星）
IOT_MQTT_ENABLED=false
IOT_MQTT_BROKER=tcp://localhost:1883

# EMQX 控制台（docker-compose profile iot）
EMQX_DASHBOARD_PASSWORD=public123

# 政务前置机（卫星）
GOV_EXPORT_DIR=./gov-outbox
