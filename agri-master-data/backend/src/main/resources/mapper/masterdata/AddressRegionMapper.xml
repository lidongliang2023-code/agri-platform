<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agri.masterdata.mapper.AddressRegionMapper">

    <!--
      2026-10-30 补齐：接口有方法声明、仓库里没有 SQL —— 与品类/属性同一类缺口。
      没有这段 XML，/api/master-data/address/regions/tree 直接 500。
    -->

    <select id="selectByParentCode" resultType="com.agri.masterdata.entity.AddressRegion">
        SELECT * FROM agri_md_address_region
        WHERE parent_code = #{parentCode}
        ORDER BY region_code ASC
    </select>

    <select id="selectByLevel" resultType="com.agri.masterdata.entity.AddressRegion">
        SELECT * FROM agri_md_address_region
        WHERE level = #{level}
        ORDER BY region_code ASC
    </select>

    <select id="selectByRegionCode" resultType="com.agri.masterdata.entity.AddressRegion">
        SELECT * FROM agri_md_address_region
        WHERE region_code = #{regionCode}
        LIMIT 1
    </select>

</mapper>
