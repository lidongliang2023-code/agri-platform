<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agri.masterdata.mapper.DictItemMapper">

    <select id="selectDictItemsByDictId" resultType="com.agri.masterdata.vo.DictItemVO">
        SELECT di.*
        FROM agri_md_dict_item di
        WHERE di.dict_id = #{dictId} AND di.del_flag = 0
        ORDER BY di.item_sort ASC
    </select>

    <delete id="deleteByDictId">
        DELETE FROM agri_md_dict_item WHERE dict_id = #{dictId}
    </delete>
</mapper>
