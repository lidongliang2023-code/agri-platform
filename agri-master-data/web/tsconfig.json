{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "vue": ["./node_modules/vue"],
      "@agri/shared": ["../../packages/agri-shared/src/index.ts"],
      "@agri/shared/vue/list": ["../../packages/agri-shared/src/vue/list/index.ts"],
      "@agri/shared/vue/workspace": ["../../packages/agri-shared/src/vue/workspace/index.ts"],
      "@agri/shared/vue/element": ["../../packages/agri-shared/src/vue/element/index.ts"],
      "@agri/shared/vue/detail": ["../../packages/agri-shared/src/vue/detail/index.ts"],
      "@agri/shared/*": ["../../packages/agri-shared/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
