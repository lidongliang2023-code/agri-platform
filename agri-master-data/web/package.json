{
  "name": "agri-masterdata-frontend",
  "version": "1.0.0",
  "description": "主数据管理模块运营系统前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,vue --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix --ext ts,vue",
    "format": "prettier --write \"src/**/*.{ts,vue,css,less}\""
  },
  "dependencies": {
    "@agri/shared": "workspace:*",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "lodash": "^4.17.21",
    "pinia": "^2.3.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^8.56.0",
    "less": "^4.6.4",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
