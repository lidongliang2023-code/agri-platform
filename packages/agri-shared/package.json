{
  "name": "@agri/shared",
  "version": "0.1.0",
  "private": true,
  "description": "农业产业互联网平台 · 跨子系统共享资产（组件 / 布局 / 主题 / 工具 / 类型）",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens/*": "./src/tokens/*",
    "./types/*": "./src/types/*",
    "./styles/*": "./src/styles/*",
    "./vue/list": "./src/vue/list/index.ts",
    "./vue/list/*": "./src/vue/list/*",
    "./vue/workspace": "./src/vue/workspace/index.ts",
    "./vue/workspace/*": "./src/vue/workspace/*",
    "./vue/detail": "./src/vue/detail/index.ts",
    "./vue/detail/*": "./src/vue/detail/*",
    "./vue/antdv": "./src/vue/antdv/index.ts",
    "./vue/antdv/*": "./src/vue/antdv/*",
    "./vue/http": "./src/vue/http/index.ts",
    "./vue/http/*": "./src/vue/http/*",
    "./vue/map": "./src/vue/map/index.ts",
    "./vue/map/*": "./src/vue/map/*",
    "./vue/element": "./src/vue/element/index.ts",
    "./vue/element/*": "./src/vue/element/*"
  },
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "dependencies": {
    "axios": "^1.6.5"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.6",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "ant-design-vue": { "optional": true },
    "vue": { "optional": true }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
